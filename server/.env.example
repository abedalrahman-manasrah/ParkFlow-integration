NODE_ENV=development
DEV_SKIP_EMAIL_OTP=false
PORT=4000
# Server only. Never use an EXPO_PUBLIC_ variable for this key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ROAD_REPORT_EXPIRY_TRAFFIC_CONGESTION_MINUTES=30
ROAD_REPORT_EXPIRY_ACCIDENT_MINUTES=90
ROAD_REPORT_EXPIRY_CHECKPOINT_MINUTES=60
ROAD_REPORT_EXPIRY_ROAD_HAZARD_MINUTES=240
ROAD_REPORT_EXPIRY_CONSTRUCTION_MINUTES=1440
ROAD_REPORT_EXPIRY_CLOSED_ROAD_MINUTES=360
ROAD_REPORT_EXPIRY_POLICE_MINUTES=45
ROAD_REPORT_EXPIRY_OTHER_MINUTES=60
ROAD_REPORT_DUPLICATE_TRAFFIC_CONGESTION_METERS=150
ROAD_REPORT_DUPLICATE_TRAFFIC_CONGESTION_MINUTES=30
ROAD_REPORT_DUPLICATE_CHECKPOINT_METERS=120
ROAD_REPORT_DUPLICATE_CHECKPOINT_MINUTES=60
ROAD_REPORT_DUPLICATE_POLICE_METERS=120
ROAD_REPORT_DUPLICATE_POLICE_MINUTES=45
ROAD_REPORT_DUPLICATE_ACCIDENT_METERS=100
ROAD_REPORT_DUPLICATE_ACCIDENT_MINUTES=90
ROAD_REPORT_DUPLICATE_CLOSED_ROAD_METERS=100
ROAD_REPORT_DUPLICATE_CLOSED_ROAD_MINUTES=360
ROAD_REPORT_DUPLICATE_ROAD_HAZARD_METERS=75
ROAD_REPORT_DUPLICATE_ROAD_HAZARD_MINUTES=240
ROAD_REPORT_DUPLICATE_CONSTRUCTION_METERS=100
ROAD_REPORT_DUPLICATE_CONSTRUCTION_MINUTES=1440
ROAD_REPORT_DUPLICATE_OTHER_METERS=75
ROAD_REPORT_DUPLICATE_OTHER_MINUTES=60
# Neon (public demo): use the direct, non-pooled connection string (host without "-pooler") so
# `prisma migrate deploy` works, e.g.
# postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require&connect_timeout=15&connection_limit=5
DATABASE_URL=postgresql://parkflow:local-parkflow@localhost:5434/parkflow
TEST_DATABASE_URL=postgresql://parkflow:local-parkflow@localhost:5434/parkflow_test
# Render Key Value: the internal URL (redis://red-xxxx:6379) from the same Render region; use rediss:// for TLS URLs.
REDIS_URL=redis://localhost:6381
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters-access
JWT_REFRESH_SECRET=replace-with-at-least-32-random-characters-refresh
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
# Comma-separated exact origins, no trailing slash. Public demo: https://YOUR-PROJECT.vercel.app
CORS_ORIGINS=http://localhost:8081,http://localhost:8082,http://localhost:19006
# Proxy hops in front of the API so rate limits see the real client IP. Set to 1 on Render; leave unset locally.
# TRUST_PROXY=1
OSRM_BASE_URL=https://router.project-osrm.org
GOOGLE_ROUTES_API_KEY=
PAYMENT_PROVIDER=development
# Production refuses PAYMENT_PROVIDER=development unless this is true. Public demo hosting only:
# the simulated provider never calls a gateway or charges a card. Keep false for real production.
ALLOW_SIMULATED_PAYMENTS=false
PAYMENT_API_URL=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=replace-with-at-least-32-random-characters-webhook
# Supabase Storage (public demo): S3_ENDPOINT=https://PROJECT_REF.storage.supabase.co/storage/v1/s3,
# S3_REGION=the project region (e.g. eu-central-1), S3_BUCKET=an existing private bucket,
# S3_ACCESS_KEY/S3_SECRET_KEY from Storage > S3 Connection. Leave S3_PUBLIC_ENDPOINT unset there.
S3_ENDPOINT=http://localhost:9002
# Public hostname for signed URLs when the backend uses an internal Docker S3 hostname
S3_PUBLIC_ENDPOINT=http://localhost:9002
S3_REGION=us-east-1
S3_BUCKET=parkflow
S3_ACCESS_KEY=parkflow-local
S3_SECRET_KEY=parkflow-local-storage
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
EXPO_PUSH_ACCESS_TOKEN=
SEED_ADMIN_EMAIL=

# Brevo (public demo): SMTP_HOST=smtp-relay.brevo.com, SMTP_PORT=2525, SMTP_SECURE=false (STARTTLS),
# SMTP_USER=the Brevo SMTP login, SMTP_PASSWORD=a Brevo SMTP key, EMAIL_FROM=a verified Brevo sender.
EMAIL_PROVIDER=smtp
EMAIL_FROM=awwadh311@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=awwadh311@gmail.com
SMTP_PASSWORD=

# Crash detection: the number the phone calls after an unanswered crash countdown.
# Leave empty to keep emergency calling off. Digits only, optional leading +.
EMERGENCY_CALL_NUMBER=
# Seconds the driver gets to cancel before the call is placed (5-60).
EMERGENCY_COUNTDOWN_SECONDS=15
