# Compatibility reference. Use apps/customer/.env and apps/management/.env for the separate frontends.
# Use the computer's LAN IP for physical devices; localhost is only for a web browser on this computer.
# Cloud proxy web builds: use this project's absolute HTTPS origin/api/v1 and enable polling below.
# Direct API web builds: use https://api.YOUR-DOMAIN/api/v1 under the same HTTPS site as both frontends.
# Direct vercel.app -> onrender.com requests are cross-site; use the configured same-origin proxy for browser sign-in.
# Create two Vercel projects at the repository root; set PARKFLOW_WEB_APPLICATION=customer or management
# in the matching project dashboard. See DEPLOYMENT.md for exact, disjoint server WEB_*_ORIGINS.
# PARKFLOW_WEB_APPLICATION=customer
EXPO_PUBLIC_API_BASE_URL=http://YOUR_COMPUTER_LAN_IP:4000/api/v1
# true only for a demo build whose backend runs simulated payments; shows a "Demo payment" notice in Wallet.
EXPO_PUBLIC_SIMULATED_PAYMENTS=false
# Dashboard warning provider settings (GEMINI_API_KEY / GEMINI_MODEL) belong only in server/.env; see server/.env.example.
EXPO_PUBLIC_DEV_SKIP_EMAIL_OTP=false
EXPO_PUBLIC_START_FROM_BEGINNING=false
# Optional native push setup (requires an EAS development/production build)
EXPO_PUBLIC_EAS_PROJECT_ID=
GOOGLE_SERVICES_JSON=
GOOGLE_MAPS_API_KEY=

# Set to true only on a development machine to show the on-map test location control.
EXPO_PUBLIC_SHOW_TEST_LOCATION=false
# Enable only for browser cloud builds using the same-origin API and Socket.IO HTTP proxy.
# Native connections and builds without this opt-in keep WebSocket transport.
EXPO_PUBLIC_WEB_SOCKET_POLLING=false
