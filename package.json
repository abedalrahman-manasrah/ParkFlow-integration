{
  "name": "parkflow-workspace",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "node scripts/verify-frontend-security-vendors.cjs",
    "security:patch": "node scripts/verify-frontend-security-vendors.cjs",
    "security:verify": "node scripts/verify-frontend-security-vendors.cjs",
    "prestart": "npm run security:verify",
    "preweb": "npm run security:verify",
    "preandroid": "npm run security:verify",
    "preios": "npm run security:verify",
    "predev:customer": "npm run security:verify",
    "predev:management": "npm run security:verify",
    "pretypecheck": "npm run security:verify",
    "pretest": "npm run security:verify",
    "pretest:contracts": "npm run security:verify",
    "preexport:customer": "npm run security:verify",
    "preexport:management": "npm run security:verify",
    "start": "npm run start --workspace @parkflow/customer --",
    "web": "npm run web --workspace @parkflow/customer --",
    "android": "npm run android --workspace @parkflow/customer --",
    "ios": "npm run ios --workspace @parkflow/customer --",
    "dev:customer": "npm run web --workspace @parkflow/customer",
    "dev:management": "npm run web --workspace @parkflow/management",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "node --test --test-concurrency=1 tests/*.test.cjs",
    "test:contracts": "node scripts/check-client-contracts.cjs",
    "export:customer": "npm run export --workspace @parkflow/customer",
    "export:management": "npm run export --workspace @parkflow/management",
    "preexport:customer:web": "npm run security:verify",
    "export:customer:web": "npm run export:web --workspace @parkflow/customer",
    "preexport:management:web": "npm run security:verify",
    "export:management:web": "npm run export:web --workspace @parkflow/management"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.9",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    },
    "braces": "file:security/vendor/archives/parkflow-security-braces-3.0.3-parkflow.1.tgz",
    "node-forge": "file:security/vendor/archives/parkflow-security-node-forge-1.4.0-parkflow.1.tgz",
    "decode-uri-component": "file:security/vendor/archives/parkflow-security-decode-uri-component-0.2.2-parkflow.1.tgz"
  }
}
